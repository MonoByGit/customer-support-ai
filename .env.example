# ==============================================================================
# VERDE WHATSAPP AI BOEKINGSENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. LLM ENGINE (DeepSeek API - Primary Recommendation)
# Haal je API sleutel op via: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# 2. LLM ENGINE (Google Gemini Flash - Alternatief)
# Haal je API sleutel op via: https://aistudio.google.com
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. GOOGLE CALENDAR INTEGRATION (Optioneel voor live 2-way sync)
# Laat leeg om automatisch de in-memory sandbox / mock kalender te gebruiken
GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# 4. META WHATSAPP CLOUD API (Optioneel voor live nummer koppeling)
# Configureren via Meta for Developers (https://developers.facebook.com)
META_WHATSAPP_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=109283746501928
META_WEBHOOK_VERIFY_TOKEN=whatsapp_ai_verify_token_2026

# 5. SERVER RUNTIME
PORT=3005
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://jouw-railway-app.up.railway.app
