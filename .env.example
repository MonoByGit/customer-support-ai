# ==============================================================================
# VERDE AI — WHATSAPP BOEKINGSENGINE · ENVIRONMENT
# ==============================================================================

# 1. AI-ENGINE (DeepSeek — de enige LLM-provider in dit project)
# Sleutel via https://platform.deepseek.com
# Zonder sleutel draait de deterministische fallback-receptionist: de simulator
# blijft werken, maar zonder vrije conversatie.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# 2. PERSISTENTE OPSLAG (belangrijk op Railway)
# De container-filesystem is vluchtig: zonder volume verdwijnen alle gegenereerde
# klantprofielen bij de eerstvolgende deploy. Koppel een Railway Volume en zet
# DATA_DIR op het mountpad. De voorbeeldprofielen worden eenmalig geseed.
DATA_DIR=/data

# 3. GOOGLE AGENDA (optioneel — zonder dit draait de sandbox-agenda)
GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# 4. META WHATSAPP CLOUD API (optioneel — voor koppeling aan een echt nummer)
META_WHATSAPP_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=109283746501928
META_WEBHOOK_VERIFY_TOKEN=whatsapp_ai_verify_token_2026

# Profiel dat inkomende webhook-berichten afhandelt zolang er niet op
# phone_number_id wordt gerouteerd.
DEFAULT_PROFILE_SLUG=tandartspraktijk-amsterdam

# 5. RUNTIME
# Railway injecteert PORT zelf; niet hardcoden in productie.
NEXT_PUBLIC_APP_URL=https://verde-whatsapp-ai-production.up.railway.app

# 6. SESSIELIMIETEN VOOR INTERACTIEVE TESTS
# Drie plafonds die op elkaar zijn afgestemd: wie eerst op is, sluit de sessie.
# Ruim genoeg om echt te testen, te krap om op onze rekening door te praten.
SESSION_MAX_MINUTES=10
SESSION_MAX_MESSAGES=15
SESSION_MAX_TOKENS=40000
